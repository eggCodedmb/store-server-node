# =============================================================================
# Store Server Node - 生产环境配置文件 (已同步现有配置值)
# =============================================================================

# -----------------------------------------------------------------------------
# 基础配置 (App Settings)
# -----------------------------------------------------------------------------
# 应用监听端口
APP_PORT=8800

# 接口基础 URL (用于生成文件访问链接，确保以 / 结尾)
# 生产环境建议修改为您的域名，如: https://api.yourdomain.com/
BASEURL=http://192.168.1.225:8800/

# -----------------------------------------------------------------------------
# 数据库配置 (MySQL Settings)
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=store
MYSQL_ROOT=root
MYSQL_PASSWORD=123456

# -----------------------------------------------------------------------------
# Redis 配置 (Redis Settings)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# 安全与认证 (Security & Authentication)
# -----------------------------------------------------------------------------
# JWT 签名秘钥 (生产环境请务必修改为更复杂的随机字符串)
JWT_SECRET=qwertgfyhj

# -----------------------------------------------------------------------------
# 微信小程序配置 (WeChat Mini Program)
# -----------------------------------------------------------------------------
WX_APPID=wx764f09d8c31f970a
WX_APPSECRET=72985bc28e8d6e285d517a9ebe5b720f

# -----------------------------------------------------------------------------
# 文件上传配置 (File Upload)
# -----------------------------------------------------------------------------
# 存储类型: local (本地) / minio (Minio 服务器) / online (外部)
UPLOAD_TYPE=online

# 允许上传的文件 MIME 类型 (以英文逗号分隔)
FILE_TYPE=image/jpeg,image/png,image/jpg

# --- Minio 专用配置 (当 UPLOAD_TYPE=minio 时生效) ---
# Minio 服务器端点 (不带协议头)
STORAGE_HOST=127.0.0.1
# Minio 存储桶名称
STORAGE_BUCKET=test
# Minio Access Key
STORAGE_AccessKey=reK2iGO0JtSnoo195SqE
# Minio Secret Key
STORAGE_SecretKey=tZN3YhcIvAf6qFg2iR8nzJeD6AW9szZxoj5C31Xn

# 订单超时时间 (单位：分钟，默认 15)
ORDER_TIMEOUT=15
